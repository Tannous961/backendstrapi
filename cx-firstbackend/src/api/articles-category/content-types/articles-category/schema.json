{
  "kind": "collectionType",
  "collectionName": "articles_categories",
  "info": {
    "singularName": "articles-category",
    "pluralName": "articles-categories",
    "displayName": "Articles Category"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "parent": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article"
    },
    "name": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "targetField": "name"
    },
    "banner": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "component-topbanner.banner",
      "repeatable": false
    }
  }
}
